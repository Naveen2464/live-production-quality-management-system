# System Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=nidec-super-secret-key-change-in-production-2026-secure-jwt-token
ACCESS_TOKEN_EXPIRE_MINUTES=720

# PostgreSQL 16 Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nidec_production_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nidec_production_db

# Active Directory (LDAP) Integration (when configured by Corporate IT)
AD_ENABLED=False
AD_SERVER=ldap://corp.nidec-system.local
AD_DOMAIN=nidec-system.local
AD_SEARCH_BASE=DC=nidec-system,DC=local

